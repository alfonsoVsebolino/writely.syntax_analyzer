<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane"
            prefHeight="750.0"
            prefWidth="1200.0"
            styleClass="root-pane"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.writely.syntax_analyzer.app.WorkspaceController">

    <!-- Top Header Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="header-bar">
            <Label styleClass="brand-logo" text="writely" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="deepScanButton"
                    mnemonicParsing="false"
                    onAction="#handleDeepScan"
                    styleClass="btn-deep-scan"
                    text="Initiate Deep Scan 💡" />
            <Button fx:id="ingestFileButton"
                    mnemonicParsing="false"
                    onAction="#handleIngestFile"
                    styleClass="btn-ingest"
                    text="Ingest file 📤" />
        </HBox>
    </top>

    <!-- Center Workspace: 3 Columns -->
    <center>
        <HBox spacing="16" styleClass="workspace-body">
            <!-- Left Pane: File Explorer -->
            <VBox fx:id="explorerPane" maxWidth="320.0" minWidth="180.0" prefWidth="230.0" spacing="12" styleClass="explorer-pane">
                <TextField fx:id="searchField" promptText="🔍 Search files..." styleClass="search-field" />
                <TreeView fx:id="fileTreeView" styleClass="file-tree-view" VBox.vgrow="ALWAYS" />
                <Button fx:id="newFolderButton"
                        maxWidth="Infinity"
                        mnemonicParsing="false"
                        onAction="#handleNewFolder"
                        styleClass="new-folder-btn"
                        text="+ New Folder" />
            </VBox>

            <!-- Center Pane: Editor & Tabs -->
            <VBox styleClass="editor-pane" HBox.hgrow="ALWAYS">
                <TabPane fx:id="editorTabPane"
                         styleClass="editor-tab-pane"
                         tabClosingPolicy="ALL_TABS"
                         VBox.vgrow="ALWAYS">
                    <tabs>
                        <Tab fx:id="activeTab" closable="true" text="filename.py">
                            <HBox styleClass="editor-content-box">
                                <TextArea fx:id="lineGutterArea"
                                          editable="false"
                                          focusTraversable="false"
                                          maxWidth="48.0"
                                          minWidth="48.0"
                                          prefWidth="48.0"
                                          styleClass="line-gutter"
                                          wrapText="false" />
                                <TextArea fx:id="editorTextArea"
                                          styleClass="code-editor"
                                          wrapText="false"
                                          HBox.hgrow="ALWAYS" />
                            </HBox>
                        </Tab>
                    </tabs>
                </TabPane>
            </VBox>

            <!-- Right Dock: Insights, Tokens & AST -->
            <VBox maxWidth="480.0" minWidth="280.0" prefWidth="380.0" spacing="0" styleClass="right-dock">
                <TabPane fx:id="rightDockTabPane"
                         styleClass="right-dock-tab-pane"
                         tabClosingPolicy="UNAVAILABLE"
                         VBox.vgrow="ALWAYS">
                    <tabs>
                        <!-- Tab 1: Insights & Diagnostics -->
                        <Tab fx:id="insightsTab" text="Insights &amp; Diagnostics">
                            <VBox spacing="16" styleClass="tab-content-box">
                                <!-- Status Banner -->
                                <HBox fx:id="statusBannerContainer" alignment="CENTER_LEFT" spacing="10" styleClass="status-banner, status-banner-idle">
                                    <Label fx:id="statusBanner" maxWidth="Infinity" styleClass="status-banner-text" text="IDLE" HBox.hgrow="ALWAYS" />
                                </HBox>

                                <!-- Syntax Metric Insights Card -->
                                <VBox styleClass="card, metric-card-container">
                                    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="card-header">
                                        <Label styleClass="card-title" text="SYNTAX METRIC INSIGHTS" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <HBox alignment="CENTER_LEFT" spacing="6">
                                            <Label styleClass="badge-label" text="TOTAL ISSUES" />
                                            <Label fx:id="totalIssuesBadge" styleClass="total-issues-pill" text="0" />
                                        </HBox>
                                    </HBox>
                                    <VBox spacing="12" styleClass="card-body">
                                        <!-- Metrics Grid -->
                                        <GridPane hgap="10" vgap="10" styleClass="metrics-grid">
                                            <columnConstraints>
                                                <ColumnConstraints percentWidth="50" />
                                                <ColumnConstraints percentWidth="50" />
                                            </columnConstraints>
                                            <VBox styleClass="metric-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                                <Label styleClass="metric-label" text="TOTAL LINES" />
                                                <Label fx:id="totalLinesLabel" styleClass="metric-value" text="0" />
                                            </VBox>
                                            <VBox styleClass="metric-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                                <Label styleClass="metric-label" text="VALID LINES" />
                                                <Label fx:id="validLinesLabel" styleClass="metric-value" text="0" />
                                            </VBox>
                                            <VBox styleClass="metric-card" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                                <Label styleClass="metric-label" text="FLAGGED LINES" />
                                                <Label fx:id="flaggedLinesLabel" styleClass="metric-value" text="0" />
                                            </VBox>
                                            <VBox styleClass="metric-card" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                                <Label styleClass="metric-label" text="TOTAL ISSUES" />
                                                <Label fx:id="totalIssuesLabel" styleClass="metric-value" text="0" />
                                            </VBox>
                                        </GridPane>

                                        <!-- Metric Subrow (Errors, Warnings, Status Badge) -->
                                        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="metric-subrow">
                                            <HBox alignment="CENTER_LEFT" spacing="6">
                                                <Label styleClass="metric-label" text="Errors:" />
                                                <Label fx:id="errorCountLabel" styleClass="metric-value-error" text="0" />
                                            </HBox>
                                            <HBox alignment="CENTER_LEFT" spacing="6">
                                                <Label styleClass="metric-label" text="Warnings:" />
                                                <Label fx:id="warningCountLabel" styleClass="metric-value-warning" text="0" />
                                            </HBox>
                                            <Region HBox.hgrow="ALWAYS" />
                                            <Label fx:id="statusBadgeLabel" styleClass="status-pill, status-idle" text="IDLE" />
                                        </HBox>

                                        <!-- Category Breakdown Section -->
                                        <VBox spacing="8" styleClass="category-breakdown-section">
                                            <Label styleClass="section-subheading" text="CATEGORY BREAKDOWN" />
                                            <FlowPane fx:id="categoryBreakdownContainer" hgap="8" vgap="8" styleClass="category-breakdown-container" />
                                        </VBox>

                                        <!-- Report Export Actions -->
                                        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="export-actions-row">
                                            <Label styleClass="section-subheading" text="EXPORT REPORT" />
                                            <Region HBox.hgrow="ALWAYS" />
                                            <Button fx:id="exportTextButton"
                                                    mnemonicParsing="false"
                                                    onAction="#handleExportText"
                                                    styleClass="btn-export"
                                                    text="Export .txt 📄" />
                                            <Button fx:id="exportJsonButton"
                                                    mnemonicParsing="false"
                                                    onAction="#handleExportJson"
                                                    styleClass="btn-export"
                                                    text="Export .json ⚙️" />
                                        </HBox>
                                    </VBox>
                                </VBox>

                                <!-- Diagnostics Findings Card -->
                                <VBox styleClass="card, diagnostics-card" VBox.vgrow="ALWAYS">
                                    <HBox alignment="CENTER_LEFT" styleClass="card-header">
                                        <Label styleClass="card-title" text="DIAGNOSTICS" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label fx:id="diagnosticsCountLabel" styleClass="badge-label" text="0 items" />
                                    </HBox>
                                    <Label fx:id="emptyStateBanner"
                                           managed="false"
                                           styleClass="empty-state-banner"
                                           text="No syntax issues detected. Code is syntactically valid."
                                           visible="false"
                                           wrapText="true" />
                                    <ScrollPane fx:id="diagnosticsScrollPane"
                                                fitToHeight="true"
                                                fitToWidth="true"
                                                styleClass="diagnostics-scroll"
                                                VBox.vgrow="ALWAYS">
                                        <VBox fx:id="diagnosticsListContainer" spacing="8" styleClass="diagnostics-list" />
                                    </ScrollPane>
                                </VBox>
                            </VBox>
                        </Tab>

                        <!-- Tab 2: Tokens Table -->
                        <Tab fx:id="tokensTab" text="Tokens Table">
                            <VBox spacing="12" styleClass="tab-content-box, tokens-box">
                                <TextField fx:id="tokenSearchField"
                                           promptText="🔍 Filter tokens..."
                                           styleClass="search-field, token-search-field" />
                                <TableView fx:id="tokensTableView"
                                           styleClass="tokens-table-view"
                                           VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="tokenTypeColumn" prefWidth="85.0" text="Type" />
                                        <TableColumn fx:id="tokenLexemeColumn" prefWidth="105.0" text="Lexeme" />
                                        <TableColumn fx:id="tokenCoordinatesColumn" prefWidth="70.0" text="Line:Col" />
                                        <TableColumn fx:id="tokenChannelColumn" prefWidth="75.0" text="Channel" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </VBox>
                        </Tab>

                        <!-- Tab 3: AST TreeView -->
                        <Tab fx:id="astTab" text="AST TreeView">
                            <VBox spacing="10" styleClass="tab-content-box, ast-box">
                                <HBox alignment="CENTER_LEFT" spacing="8" styleClass="ast-toolbar">
                                    <Button fx:id="expandAllButton"
                                            mnemonicParsing="false"
                                            onAction="#handleExpandAllAst"
                                            styleClass="ast-tool-btn"
                                            text="Expand All" />
                                    <Button fx:id="collapseAllButton"
                                            mnemonicParsing="false"
                                            onAction="#handleCollapseAllAst"
                                            styleClass="ast-tool-btn"
                                            text="Collapse All" />
                                </HBox>
                                <Label fx:id="astEmptyStateLabel"
                                       managed="false"
                                       styleClass="ast-empty-banner"
                                       text="Syntax Tree unavailable due to syntax errors. Fix diagnostics in the Insights tab to generate complete AST."
                                       visible="false"
                                       wrapText="true" />
                                <TreeView fx:id="astTreeView"
                                          styleClass="ast-tree-view"
                                          VBox.vgrow="ALWAYS" />
                            </VBox>
                        </Tab>
                    </tabs>
                </TabPane>
            </VBox>
        </HBox>
    </center>

    <!-- Bottom Footer Status Bar -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="footer-bar">
            <Label fx:id="footerStatusLabel" styleClass="footer-item" text="Ready" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="footerLanguageLabel" styleClass="footer-item" text="Python" />
            <Label fx:id="footerLinesLabel" styleClass="footer-item" text="0 lines" />
            <Label fx:id="footerTokensLabel" styleClass="footer-item" text="0 tokens" />
        </HBox>
    </bottom>

</BorderPane>
